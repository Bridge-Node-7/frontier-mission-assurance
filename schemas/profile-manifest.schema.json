{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-node-7.github.io/frontier-mission-assurance/profile-manifest.schema.json",
  "title": "Frontier Mission Assurance Profile Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "profile_id",
    "profile_name",
    "profile_version",
    "introduced_in_fma_release",
    "profile_contract",
    "validator"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "introduced_in_fma_release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_contract": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
