{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-node-7.github.io/frontier-mission-assurance/assurance-context.schema.json",
  "title": "Frontier Mission Assurance Context Export",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "context_id",
    "source_release",
    "system_ref",
    "decision",
    "affected_claims",
    "changed_assumptions",
    "artifact_states",
    "evidence_applicability_changes",
    "expert_reviews",
    "reevaluation_opportunities",
    "authoritative_source_refs",
    "handling"
  ],
  "properties": {
    "contract_id": {"const": "bn7.frontier-mission-assurance.assurance-context"},
    "contract_version": {"const": "0.1.0"},
    "context_id": {"type": "string", "pattern": "^FMA-CTX-[A-Z0-9-]+$"},
    "source_release": {
      "type": "object",
      "required": ["repository", "release", "commit"],
      "properties": {
        "repository": {"const": "Bridge-Node-7/frontier-mission-assurance"},
        "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "system_ref": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "required": ["decision_ref", "current_disposition", "reopen_required", "reconsideration_conditions"],
      "properties": {
        "decision_ref": {"type": "string", "minLength": 1},
        "current_disposition": {"enum": ["APPROVE", "HOLD", "REVISE", "REJECT"]},
        "reopen_required": {"type": "boolean"},
        "reconsideration_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "affected_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["claim_ref", "authority_state", "assurance_state"],
        "properties": {
          "claim_ref": {"type": "string", "minLength": 1},
          "authority_state": {"enum": ["DECLARED", "ESTABLISHED"]},
          "assurance_state": {"enum": ["SUPPORTED_WITHIN_SCOPE", "REVIEW_REQUIRED", "NOT_SUPPORTED_WITHIN_SCOPE"]}
        },
        "additionalProperties": false
      }
    },
    "changed_assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["assumption_ref", "impact"],
        "properties": {
          "assumption_ref": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "artifact_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "state", "reason"],
        "properties": {
          "artifact_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["CURRENT", "STALE", "REVIEW_REQUIRED"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence_applicability_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["evidence_ref", "previous_applicability", "current_applicability", "authority_state", "reproduction_state"],
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1},
          "previous_applicability": {"enum": ["IN_SCOPE", "REVIEW_REQUIRED", "OUTSIDE_ENVELOPE"]},
          "current_applicability": {"enum": ["IN_SCOPE", "REVIEW_REQUIRED", "OUTSIDE_ENVELOPE"]},
          "authority_state": {"enum": ["DECLARED", "ESTABLISHED"]},
          "reproduction_state": {"enum": ["NOT_ASSESSED", "EXTERNAL_REPORTED", "REPRODUCED"]}
        },
        "additionalProperties": false
      }
    },
    "expert_reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["review_ref", "state", "reopened", "question"],
        "properties": {
          "review_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["SUPPORTED_WITHIN_SCOPE", "REVIEW_REQUIRED", "NOT_REVIEWED", "NOT_SUPPORTED_WITHIN_SCOPE"]},
          "reopened": {"type": "boolean"},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reevaluation_opportunities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["opportunity_ref", "state", "reason"],
        "properties": {
          "opportunity_ref": {"type": "string", "minLength": 1},
          "state": {"const": "RE-EVALUATION_OPPORTUNITY"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "authoritative_source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["record_id", "record_version", "content_sha256", "authoritative_location"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "record_version": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "authoritative_location": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "handling": {
      "type": "object",
      "required": ["classification", "contains_raw_evidence"],
      "properties": {
        "classification": {"enum": ["PUBLIC_REFERENCE", "PRIVATE", "PROTECTED"]},
        "contains_raw_evidence": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
