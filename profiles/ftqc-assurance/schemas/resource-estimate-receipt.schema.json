{
  "$id": "urn:bn7:ftqc-assurance:resource-estimate-receipt:0.1",
  "title": "FTQC Resource Estimate Receipt (v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "record_class", "record_id", "system_ref", "estimator", "problem", "assumption_refs", "result", "provenance", "applicability_envelope_ref", "review_state"],
  "properties": {
    "profile_version": {"const": "0.1"},
    "record_class": {"enum": ["synthetic", "private"]},
    "record_id": {"type": "string", "minLength": 1},
    "system_ref": {"type": "string", "minLength": 1},
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration_ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_ref": {"type": "string", "minLength": 1}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_ref", "algorithm_ref"],
      "properties": {
        "workload_ref": {"type": "string", "minLength": 1},
        "algorithm_ref": {"type": "string", "minLength": 1}
      }
    },
    "assumption_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_qubits", "runtime_seconds", "synthetic_only"],
      "properties": {
        "physical_qubits": {"type": "integer", "minimum": 1},
        "runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
        "synthetic_only": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "research_receipt_ref"],
      "properties": {
        "status": {"enum": ["EXACT_RECEIPT_REF", "DECLARED_ONLY"]},
        "research_receipt_ref": {"type": ["string", "null"]}
      }
    },
    "applicability_envelope_ref": {"type": "string", "minLength": 1},
    "review_state": {"enum": ["CURRENT", "REVIEW_REQUIRED", "STALE"]}
  }
}
