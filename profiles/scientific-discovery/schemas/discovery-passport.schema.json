{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Bridge-Node-7/frontier-mission-assurance/blob/main/profiles/scientific-discovery/schemas/discovery-passport.schema.json",
  "title":"FMA Scientific Discovery Passport","type":"object","additionalProperties":false,
  "required":["passport_version","discovery_id","title","problem_specification","claim","contributors","execution","provenance","verification","attribution","decision_authority","created_at"],
  "properties":{
    "passport_version":{"const":"1.0"},"discovery_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"problem_specification":{"type":"string","minLength":1},
    "claim":{"type":"object","additionalProperties":false,"required":["statement","scope","state"],"properties":{"statement":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"state":{"enum":["PROPOSED","UNDER_REVIEW","SUPPORTED","CHALLENGED","REJECTED"]}}},
    "contributors":{"type":"object","additionalProperties":false,"required":["human","machine"],"properties":{"human":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["contributor_ref","role"],"properties":{"contributor_ref":{"type":"string","minLength":1},"role":{"type":"string","minLength":1}}}},"machine":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["system_ref","model_ref","role"],"properties":{"system_ref":{"type":"string","minLength":1},"model_ref":{"type":"string","minLength":1},"role":{"type":"string","minLength":1}}}}}},
    "execution":{"type":"object","additionalProperties":false,"required":["environment_ref","agent_topology","agent_count","started_at","ended_at"],"properties":{"environment_ref":{"type":"string","minLength":1},"agent_topology":{"type":"string","minLength":1},"agent_count":{"type":"integer","minimum":0},"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source_refs","research_trigger_refs","research_boundary_attestation_ref","agent_provenance_refs"],"properties":{"source_refs":{"type":"array","items":{"type":"string","minLength":1}},"research_trigger_refs":{"type":"array","items":{"type":"string","minLength":1}},"research_boundary_attestation_ref":{"type":"string","minLength":1},"agent_provenance_refs":{"type":"array","items":{"type":"string","minLength":1}}}},
    "verification":{"type":"object","additionalProperties":false,"required":["formal_proof_ref","replication_refs","adversarial_findings","limitations","open_objections","disposition"],"properties":{"formal_proof_ref":{"type":["string","null"]},"replication_refs":{"type":"array","items":{"type":"string","minLength":1}},"adversarial_findings":{"type":"array","items":{"type":"string","minLength":1}},"limitations":{"type":"array","items":{"type":"string","minLength":1}},"open_objections":{"type":"array","items":{"type":"string","minLength":1}},"disposition":{"enum":["PASS","CONDITIONAL_PASS","REVIEW_REQUIRED","FAIL"]}}},
    "attribution":{"type":"object","additionalProperties":false,"required":["priority_receipt_ref","events","conflicts"],"properties":{"priority_receipt_ref":{"type":"string","minLength":1},"events":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["event_type","actor_ref","asserted_at","evidence_ref"],"properties":{"event_type":{"enum":["CONCEPT","CONSTRUCTION","PROOF","FORMALIZATION","PUBLICATION","REPLICATION","VALIDATION"]},"actor_ref":{"type":"string","minLength":1},"asserted_at":{"type":"string","format":"date-time"},"evidence_ref":{"type":"string","minLength":1}}}},"conflicts":{"type":"array","items":{"type":"string","minLength":1}}}},
    "decision_authority":{"type":"object","additionalProperties":false,"required":["authority_type","authority_ref"],"properties":{"authority_type":{"enum":["HUMAN","INSTITUTIONAL"]},"authority_ref":{"type":"string","minLength":1}}},
    "created_at":{"type":"string","format":"date-time"},"metadata":{"type":"object","additionalProperties":false,"properties":{"synthetic":{"type":"boolean"}}}
  }
}
